# .gitignore

#   About: File forces Git to ignore selected directories or files.
#   Initial Commit: INIT
#   Commit Year: 2026
#   Licensed Under: MIT
#   Committer: Nico Erdmann
#   Author: Nico Erdmann 

# Build and output directories
build/
bin/
out/

# Compiled object and library files
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# OS generated files
.DS_Store
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo